@ARTICLE{10.3389/fenrg.2021.752571,
  
AUTHOR={Yu, Huang  and Wu, Yufeng  and Guan, Weiling  and Zhang, Daolu  and Yu, Tao  and Liu, Qianjin },
         
TITLE={Practical Method for Data-Driven User Phase Identification in Low-Voltage Distribution Networks},
        
JOURNAL={Frontiers in Energy Research},
        
VOLUME={Volume 9 - 2021},

YEAR={2021},

URL={https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2021.752571},

DOI={10.3389/fenrg.2021.752571},

ISSN={2296-598X},

ABSTRACT={ For low voltage distribution network (LVDN), accurate models depicting network and phase connectivity are crucial to the analysis, planning, and operation of these networks.  However, phase connectivity data in LVDN is usually incorrect or missing. Wrong or incomplete phase information collected could lead to unbalanced operation of three-phase distribution systems and increased power loss. Based on advanced measurement infrastructure (AMI) in development of smart gird, in this study, a novel data-driven phase identification algorithm is proposed. Firstly, the method involves extracting features from voltage-time matrices using a nonlinear dimension reduction algorithm. Secondly, density-based spatial clustering of applications with noise (DBSCAN) algorithm is used to divide customers into clusters with arbitrary shape. Finally, the algorithms were tested with the IEEE European Low Voltage Test Feeder of the IEEE PES AMPS DSAS Test Feeder working group. The results showed an accuracy of over 90% for the method.}}

